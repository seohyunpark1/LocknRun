# Copy this file to .env.local and fill in the values. Run `npm run setup` to create the two wallets.

# Solana RPC. The public devnet RPC works; a QuickNode devnet endpoint is faster.
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# Circle's USDC mint on Solana devnet.
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# SPONSOR wallet: stands in for a card / Apple Pay on-ramp (funds deposits) and pays all network fees.
# Needs devnet SOL + devnet USDC.
SPONSOR_SECRET_KEY=

# ESCROW wallet: holds every deposit until the challenge pays out.
# Needs nothing; the sponsor pays its fees.
ESCROW_SECRET_KEY=

# Storage. On Vercel, add "Upstash for Redis" (Storage / Marketplace tab) and connect it to the
# project: it fills in KV_REST_API_URL and KV_REST_API_TOKEN automatically. Locally, leave them empty
# and challenges are saved to a JSON file instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: where challenges are saved. Defaults to data/challenges.json (or /tmp on Vercel).
# LOCKRUN_DATA_FILE=

# Optional: ElevenLabs voice coach + payout announcements. Falls back to the browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: Strava import. Create an app at https://www.strava.com/settings/api
# and set "Authorization Callback Domain" to your site's domain (e.g. locknrun.vercel.app, or localhost).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
